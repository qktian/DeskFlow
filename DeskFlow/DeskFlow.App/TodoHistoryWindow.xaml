<Window x:Class="DeskFlow.App.TodoHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办历史"
        Width="760"
        Height="580"
        MinWidth="600"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F7F7F5">
    <Window.Resources>
        <Style x:Key="GroupTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2C2C2A" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style x:Key="EmptyStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9A9A96" />
            <Setter Property="Margin" Value="2,0,0,12" />
        </Style>

        <DataTemplate x:Key="HistoryRowTemplate">
            <Border CornerRadius="8"
                    Padding="10,8"
                    Margin="0,0,0,6"
                    Background="#FFFFFF"
                    BorderBrush="#E4E4E0"
                    BorderThickness="1"
                    Tag="{Binding}"
                    MouseLeftButtonUp="Row_OnMouseLeftButtonUp"
                    MouseRightButtonUp="Row_OnMouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="{Binding IndentMargin}">
                        <TextBlock Text="{Binding DisplayTitle}"
                                   FontSize="13"
                                   Foreground="#22221F"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MetaText}"
                                   FontSize="11"
                                   Foreground="#77767B"
                                   Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding StatusText}"
                                   FontSize="11"
                                   Foreground="{Binding StatusBrush}"
                                   VerticalAlignment="Center" />
                        <Border Width="9" Height="9"
                                CornerRadius="4.5"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Background="{Binding PriorityBrush}"
                                ToolTip="{Binding PriorityTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox"
                     Height="30"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     Padding="8,0"
                     ToolTip="按标题或清单名称筛选"
                     TextChanged="SearchBox_OnTextChanged" />
            <TextBlock x:Name="SummaryText"
                       Grid.Column="1"
                       FontSize="12"
                       Foreground="#77767B"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0" />
        </Grid>

        <TabControl Grid.Row="1">
            <TabItem Header="普通任务">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">
                        <TextBlock x:Name="PendingTitle" Style="{StaticResource GroupTitleStyle}" />
                        <ItemsControl x:Name="PendingHost" ItemTemplate="{StaticResource HistoryRowTemplate}" />
                        <TextBlock x:Name="PendingEmpty" Text="没有未完成的任务" Style="{StaticResource EmptyStyle}" />

                        <TextBlock x:Name="DoneTitle" Style="{StaticResource GroupTitleStyle}" />
                        <ItemsControl x:Name="DoneHost" ItemTemplate="{StaticResource HistoryRowTemplate}" />
                        <TextBlock x:Name="DoneEmpty" Text="还没有已完成的任务" Style="{StaticResource EmptyStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="循环任务">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8">
                        <TextBlock x:Name="ActiveTitle" Style="{StaticResource GroupTitleStyle}" />
                        <ItemsControl x:Name="ActiveHost" ItemTemplate="{StaticResource HistoryRowTemplate}" />
                        <TextBlock x:Name="ActiveEmpty" Text="没有进行中的循环任务" Style="{StaticResource EmptyStyle}" />

                        <TextBlock x:Name="ClosedTitle" Style="{StaticResource GroupTitleStyle}" />
                        <ItemsControl x:Name="ClosedHost" ItemTemplate="{StaticResource HistoryRowTemplate}" />
                        <TextBlock x:Name="ClosedEmpty" Text="没有已关闭的循环任务" Style="{StaticResource EmptyStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="刷新" Width="76" Height="32" Margin="0,0,8,0" Click="RefreshButton_OnClick" />
            <Button Content="关闭" Width="76" Height="32" IsDefault="True" IsCancel="True" Click="CloseButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
