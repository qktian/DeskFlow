<Window x:Class="DeskFlow.App.PomodoroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskFlow · 番茄钟" Width="380" Height="560" MinWidth="280" MinHeight="130"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" UseLayoutRounding="True" FontFamily="Microsoft YaHei UI" Foreground="#E9EEF5">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#AAB4C2"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#303B4B"/><Setter Property="Foreground" Value="#E9EEF5"/>
            <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Body" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Background" Value="#F0F3F7"/><Setter Property="Foreground" Value="#202938"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="14"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E9EEF5"/><Setter Property="Margin" Value="0,7"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#E9EEF5"/><Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBody" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent">
                    <ContentPresenter ContentSource="Header"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="TabBody" Property="Background" Value="#344155"/>
                </Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="#F51B2431" BorderBrush="#526071" BorderThickness="1" CornerRadius="12" Padding="12,6,12,12">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <TextBlock Text="●  番茄钟" Foreground="#FF948B" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PinButton" Content="置顶" Padding="7,3" Click="Pin_OnClick" ToolTip="切换始终置顶"/>
                    <Button x:Name="CompactButton" Content="精简" Padding="7,3" Click="Compact_OnClick"/>
                    <Button Content="×" Padding="9,3" Click="Hide_OnClick" ToolTip="收起面板，计时继续；从托盘打开"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0" SelectionChanged="Tabs_OnSelectionChanged">
                    <TabItem x:Name="TimerTab" Header="计时">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,8,0,0">
                                <UniformGrid Columns="3">
                                    <Button x:Name="FocusButton" Content="专注" Tag="Focus" Click="Phase_OnClick"/>
                                    <Button x:Name="ShortButton" Content="短休息" Tag="ShortBreak" Click="Phase_OnClick"/>
                                    <Button x:Name="LongButton" Content="长休息" Tag="LongBreak" Click="Phase_OnClick"/>
                                </UniformGrid>
                                <TextBlock x:Name="PhaseText" HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource Muted}"/>
                                <TextBlock x:Name="TimeText" Text="25:00" FontFamily="Segoe UI" FontSize="56" FontWeight="Light" HorizontalAlignment="Center"/>
                                <ProgressBar x:Name="Progress" Height="4" Margin="6,5,6,10" Maximum="1" Background="#344155" Foreground="#EF8075" BorderThickness="0"/>
                                <TextBlock x:Name="CycleText" HorizontalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                <Grid Margin="0,10,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="重置" Click="Reset_OnClick"/>
                                    <Button x:Name="StartButton" Grid.Column="1" Content="开始专注" Background="#CA6259" FontWeight="SemiBold" Click="Start_OnClick"/>
                                    <Button Grid.Column="2" Content="跳过" Click="Skip_OnClick"/>
                                </Grid>
                                <TextBlock Text="当前专注事项" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                                <ComboBox Foreground="#202938" x:Name="TaskBox" DisplayMemberPath="Title" SelectedValuePath="Id" MinHeight="34" DropDownOpened="TaskBox_OnDropDownOpened" SelectionChanged="TaskBox_OnSelectionChanged"/>
                                <TextBox x:Name="FreeTitleBox" MaxLength="120" ToolTip="自由专注的事项名称，按 Enter 或离开输入框保存" LostKeyboardFocus="FreeTitle_OnLostFocus" KeyDown="FreeTitle_OnKeyDown"/>
                                <Border Background="#253142" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <TextBlock x:Name="TodayText" FontSize="14" FontWeight="SemiBold"/>
                                        <ProgressBar x:Name="GoalProgress" Height="4" Margin="0,9,0,0" Background="#344155" Foreground="#71BBA3" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0" FontSize="12"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="StatisticsTab" Header="统计">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,14,8,0">
                                <ComboBox x:Name="StatisticsRange" Foreground="#202938" MinHeight="32" SelectedIndex="1" SelectionChanged="StatisticsRange_OnChanged">
                                    <ComboBoxItem Content="今天"/><ComboBoxItem Content="最近 7 天"/><ComboBoxItem Content="最近 30 天"/><ComboBoxItem Content="自定义日期"/>
                                </ComboBox>
                                <Grid x:Name="CustomStatisticsRange" Visibility="Collapsed" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <DatePicker x:Name="StatisticsStart" Foreground="#202938" SelectedDateFormat="Short" ToolTip="开始日期"/>
                                    <TextBlock Grid.Column="1" Text="至" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <DatePicker Grid.Column="2" x:Name="StatisticsEnd" Foreground="#202938" SelectedDateFormat="Short" ToolTip="结束日期"/>
                                </Grid>
                                <Button x:Name="ApplyStatisticsRange" Content="应用日期范围" Visibility="Collapsed" Click="ApplyStatisticsRange_OnClick"/>
                                <TextBlock x:Name="StatisticsError" Foreground="#FFAF9B" TextWrapping="Wrap" Margin="0,5"/>
                                <TextBlock x:Name="StatisticsRangeLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"/>
                                <UniformGrid Columns="2">
                                    <Border Background="#293647" CornerRadius="8" Padding="10" Margin="0,0,4,8"><StackPanel>
                                        <TextBlock Text="专注时长" Foreground="{StaticResource Muted}" FontSize="12"/>
                                        <TextBlock x:Name="StatisticsDuration" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel></Border>
                                    <Border Background="#293647" CornerRadius="8" Padding="10" Margin="4,0,0,8"><StackPanel>
                                        <TextBlock Text="完成番茄" Foreground="{StaticResource Muted}" FontSize="12"/>
                                        <TextBlock x:Name="StatisticsCompleted" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel></Border>
                                    <Border Background="#293647" CornerRadius="8" Padding="10" Margin="0,0,4,0"><StackPanel>
                                        <TextBlock Text="完成率" Foreground="{StaticResource Muted}" FontSize="12"/>
                                        <TextBlock x:Name="StatisticsRate" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel></Border>
                                    <Border Background="#293647" CornerRadius="8" Padding="10" Margin="4,0,0,0"><StackPanel>
                                        <TextBlock Text="中断专注" Foreground="{StaticResource Muted}" FontSize="12"/>
                                        <TextBlock x:Name="StatisticsInterrupted" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                    </StackPanel></Border>
                                </UniformGrid>
                                <TextBlock x:Name="StatisticsActivity" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,12"/>
                                <Border Background="#253142" Padding="10" CornerRadius="8"><StackPanel>
                                    <TextBlock x:Name="StatisticsTodayGoal" FontWeight="SemiBold"/>
                                    <ProgressBar x:Name="StatisticsGoalProgress" Height="5" Margin="0,9,0,8" Background="#344155" Foreground="#71BBA3" BorderThickness="0"/>
                                    <TextBlock x:Name="StatisticsStreak" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" ToolTip="每天至少完成 1 个番茄；今日尚未完成时，连续天数延续至昨天。最长连续天数统计全部历史。"/>
                                </StackPanel></Border>
                                <Grid Margin="0,18,0,8">
                                    <TextBlock Text="每日趋势" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="StatisticsMetric" Foreground="#202938" HorizontalAlignment="Right" MinWidth="112" SelectedIndex="0" SelectionChanged="StatisticsMetric_OnChanged">
                                        <ComboBoxItem Content="专注分钟"/><ComboBoxItem Content="完成番茄"/>
                                    </ComboBox>
                                </Grid>
                                <TextBlock x:Name="StatisticsChartLegend" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <Canvas x:Name="StatisticsChart" Height="150" Width="330" Background="#202C3B"/>
                                </ScrollViewer>
                                <TextBlock x:Name="StatisticsChartHint" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock Text="事项专注分布" FontWeight="SemiBold" Margin="0,18,0,8"/>
                                <TextBlock x:Name="StatisticsEmpty" Text="这个时间段暂无记录，完成一次专注后即可查看统计。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
                                <ListBox x:Name="StatisticsTasks" Background="Transparent" BorderThickness="0" Foreground="#E9EEF5" MaxHeight="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            <ProgressBar Value="{Binding SharePercent, Mode=OneWay}" Maximum="100" Height="4" Foreground="#71BBA3" Background="#344155" BorderThickness="0" Margin="0,7"/>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="#AAB4C2" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Button Content="导出当前范围统计 CSV…" Click="ExportStatistics_OnClick" Margin="3,12,3,8"/>
                                <TextBlock Text="统计已结束的专注，按本地结束日期归属。时长含中断的已用时间；完成率 = 完成次数 ÷（完成 + 中断次数）。休息、暂停和正在计时的这一段不计入。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="HistoryTab" Header="记录">
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="StatsText" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                            <ComboBox Foreground="#202938" x:Name="HistoryFilter" Grid.Row="1" SelectedIndex="0" Margin="0,8" MinHeight="30" SelectionChanged="HistoryFilter_OnSelectionChanged">
                                <ComboBoxItem Content="今天"/><ComboBoxItem Content="最近 7 天"/><ComboBoxItem Content="全部记录"/>
                            </ComboBox>
                            <ListBox x:Name="HistoryList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="#E9EEF5" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Border Background="#293647" CornerRadius="6" Padding="10" Margin="0,0,0,6">
                                        <StackPanel><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="#AAB4C2" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="3">
                                <TextBlock x:Name="HistoryHint" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,8" Text="只将完整专注计入番茄数；分钟含已记录的中断专注，按结束日期统计。"/>
                                <Button Content="导出全部记录 CSV…" Click="Export_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="设置">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,10,6,0">
                                <TextBlock Text="计时与目标" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="专注（1–180 分钟）"/><TextBox x:Name="FocusInput" MaxLength="3"/>
                                        <TextBlock Text="长休息（1–120 分钟）"/><TextBox x:Name="LongInput" MaxLength="3"/>
                                        <TextBlock Text="每日目标（1–30 个）"/><TextBox x:Name="GoalInput" MaxLength="2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="短休息（1–60 分钟）"/><TextBox x:Name="ShortInput" MaxLength="2"/>
                                        <TextBlock Text="长休息间隔（2–12 个）"/><TextBox x:Name="EveryInput" MaxLength="2"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="AutoBreakCheck" Content="专注结束后自动开始休息"/>
                                <CheckBox x:Name="AutoFocusCheck" Content="休息结束后自动开始下一次专注"/>
                                <CheckBox x:Name="SoundCheck" Content="阶段结束播放系统提示音"/>
                                <CheckBox x:Name="NotifyCheck" Content="阶段结束显示托盘通知"/>
                                <TextBlock Text="时长修改从下一段生效；运行或暂停中的当前段保持原时长。锁屏、休眠和退出时自动暂停。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12"/>
                                <TextBlock x:Name="SettingsMessage" TextWrapping="Wrap" Foreground="#FFAF9B" Margin="0,0,0,8"/>
                                <Button Content="保存番茄钟设置" Background="#CA6259" Click="SaveSettings_OnClick"/>
                                <Button Content="重新开始一轮" Click="ResetCycle_OnClick" Margin="3,12,3,3"/>
                                <TextBlock Text="重新开始一轮会清零本轮进度，历史记录保留。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                <Grid x:Name="CompactPanel" Visibility="Collapsed" Margin="0,4,0,0">
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock x:Name="CompactPhase" Foreground="{StaticResource Muted}"/>
                        <TextBlock x:Name="CompactTime" FontFamily="Segoe UI" FontSize="34"/>
                    </StackPanel>
                    <Button x:Name="CompactStart" Content="开始" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Start_OnClick" Padding="18,10"/>
                    <TextBlock x:Name="CompactTask" Grid.Row="1" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="12"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
