<Window x:Class="DeskFlow.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskFlow 设置"
        Width="740"
        Height="580"
        MinWidth="660"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F7F7F5">
    <Window.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2C2C2A" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#77767B" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="22,0,0,4" />
        </Style>
        <Style x:Key="OptionStyle" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#2C2C2A" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#444441" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- 常规 -->
            <TabItem Header="常规">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,10">
                        <TextBlock Text="桌面整理" Style="{StaticResource SectionTitleStyle}" />

                        <CheckBox x:Name="AutoStartCheckBox" Content="开机自动启动" Style="{StaticResource OptionStyle}" />
                        <TextBlock Text="写入当前用户的启动项，不需要管理员权限。" Style="{StaticResource HintStyle}" />

                        <CheckBox x:Name="HideIconsCheckBox" Content="隐藏系统桌面图标，改由 DeskFlow 显示（图标收编）" Style="{StaticResource OptionStyle}" />
                        <TextBlock Text="关闭后系统桌面图标会恢复显示，可能与盒内条目重复，建议保持开启。" Style="{StaticResource HintStyle}" />

                        <CheckBox x:Name="DoubleClickCheckBox" Content="双击桌面空白处隐藏 / 显示全部盒子" Style="{StaticResource OptionStyle}" />

                        <CheckBox x:Name="EdgeRollCheckBox" Content="盒子贴近屏幕左右边缘时自动卷起" Style="{StaticResource OptionStyle}" />

                        <CheckBox x:Name="SnapCheckBox" Content="拖动或缩放盒子、待办时吸附屏幕边缘" Style="{StaticResource OptionStyle}" />

                        <CheckBox x:Name="SnapBoxesCheckBox" Content="拖动或缩放时，盒子与待办相互对齐" Style="{StaticResource OptionStyle}" />

                        <DockPanel Margin="0,5">
                            <TextBlock Text="新盒子与恢复窗口的首选屏幕" Style="{StaticResource FieldLabelStyle}" DockPanel.Dock="Left" Margin="0,0,10,0" />
                            <ComboBox x:Name="PreferredMonitorBox" MinWidth="230" Height="28" />
                        </DockPanel>
                        <TextBlock Text="窗口保存为显示器内的相对位置；移除显示器后会回收到首选屏幕。" Style="{StaticResource HintStyle}" />

                        <TextBlock Text="待办组件" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox x:Name="ShowCompletedTodosCheckBox" Content="在待办面板中显示已完成的任务" Style="{StaticResource OptionStyle}" />
                        <TextBlock Text="未完成的普通任务每天都会显示（超期标红）；循环任务在其当前周期内每天显示，直到该周期打卡完成。" Style="{StaticResource HintStyle}" />

                        <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
                        <DockPanel Margin="0,5">
                            <TextBlock x:Name="GlobalIconSizeValueText" DockPanel.Dock="Right" Width="44" Text="48" Style="{StaticResource FieldLabelStyle}" />
                            <Slider x:Name="GlobalIconSizeSlider" Minimum="32" Maximum="128" Ticks="32,48,64,96,128" IsSnapToTickEnabled="True" ValueChanged="GlobalIconSizeSlider_OnValueChanged" />
                        </DockPanel>

                        <CheckBox x:Name="ForceClassifyCheckBox" Content="强制自动归类（覆盖手动调整过的条目）" Style="{StaticResource OptionStyle}" />

                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitleStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="显示 / 隐藏盒子" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                            <TextBox x:Name="ToggleHotkeyBox" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,8" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="例如 Ctrl+` 或 Ctrl+Alt+D" Style="{StaticResource HintStyle}" Margin="10,0,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="一键整理" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="OrganizeHotkeyBox" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="例如 Ctrl+Alt+O" Style="{StaticResource HintStyle}" Margin="10,0,0,0" />
                        </Grid>

                        <TextBlock Text="维护" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="立即一键整理" Width="120" Height="30" Click="OrganizeButton_OnClick" />
                            <Button Content="重新排布盒子" Width="120" Height="30" Margin="8,0,0,0" Click="RelayoutButton_OnClick" />
                            <Button Content="恢复系统桌面图标" Width="140" Height="30" Margin="8,0,0,0" Click="RestoreIconsButton_OnClick" />
                            <Button Content="清理一年以前的历史…" Width="155" Height="30" Margin="8,0,0,0" Click="PruneHistoryButton_OnClick" />
                        </StackPanel>

                        <TextBlock Text="快照" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="手动保存当前盒子的条目归属；恢复时已不存在的文件会被忽略，新增文件会按规则重新归类。" Style="{StaticResource HintStyle}" />
                        <DockPanel Margin="0,6,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="保存当前快照…" Width="130" Height="30" Click="CreateSnapshotButton_OnClick" />
                                <Button x:Name="RestoreSnapshotButton" Content="恢复选中" Width="96" Height="30" Margin="8,0,0,0" Click="RestoreSnapshotButton_OnClick" />
                                <Button x:Name="DeleteSnapshotButton" Content="删除选中" Width="96" Height="30" Margin="8,0,0,0" Click="DeleteSnapshotButton_OnClick" />
                            </StackPanel>
                            <TextBlock />
                        </DockPanel>
                        <ListBox x:Name="SnapshotList" Height="120" SelectionChanged="SnapshotList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Margin="2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 盒子 -->
            <TabItem Header="盒子">
                <Grid Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="新建" Width="68" Height="28" Click="AddBoxButton_OnClick" />
                            <Button x:Name="DeleteBoxButton" Content="删除" Width="68" Height="28" Margin="8,0,0,0" Click="DeleteBoxButton_OnClick" />
                        </StackPanel>
                        <ListBox x:Name="BoxList" SelectionChanged="BoxList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Margin="2" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0">
                        <StackPanel x:Name="BoxEditor" IsEnabled="False">
                            <TextBlock Text="盒子属性" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                                <TextBox x:Name="BoxNameBox" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="背景色" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                                <TextBox x:Name="BoxColorBox" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="文字颜色" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,8" />
                                <TextBox x:Name="BoxForeColorBox" Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="不透明度" Style="{StaticResource FieldLabelStyle}" />
                                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Width="44" Text="92%" Style="{StaticResource FieldLabelStyle}" />
                                    <Slider x:Name="OpacitySlider" Minimum="0.2" Maximum="1" TickFrequency="0.02" ValueChanged="OpacitySlider_OnValueChanged" />
                                </DockPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="圆角" Style="{StaticResource FieldLabelStyle}" />
                                <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,8">
                                    <TextBlock x:Name="RadiusValueText" DockPanel.Dock="Right" Width="44" Text="12" Style="{StaticResource FieldLabelStyle}" />
                                    <Slider x:Name="RadiusSlider" Minimum="0" Maximum="24" TickFrequency="1" ValueChanged="RadiusSlider_OnValueChanged" />
                                </DockPanel>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="排序方式" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="SortComboBox" Grid.Row="5" Grid.Column="1" Height="28" Margin="0,0,0,8" />
                            </Grid>

                            <CheckBox x:Name="ShowTitleCheckBox" Content="显示标题栏文字" Style="{StaticResource OptionStyle}" />
                            <CheckBox x:Name="PinnedCheckBox" Content="置顶显示" Style="{StaticResource OptionStyle}" />

                            <TextBlock Text="颜色使用 #AARRGGBB 格式，例如 #33000000 表示 20% 不透明度的黑色。" Style="{StaticResource HintStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 规则 -->
            <TabItem Header="归类规则">
                <Grid Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListView x:Name="RuleList" Grid.Row="0" SelectionChanged="RuleList_OnSelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="启用" Width="46">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="规则名称" Width="140" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="匹配条件" Width="220" DisplayMemberBinding="{Binding Condition}" />
                                <GridViewColumn Header="归入盒子" Width="140" DisplayMemberBinding="{Binding TargetBoxName}" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" Background="#FFFFFF" BorderBrush="#D3D1C7" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="104" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="118" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="名称" Style="{StaticResource FieldLabelStyle}" Margin="0,0,6,0" />
                            <TextBox x:Name="RuleNameBox" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="6,0" />

                            <TextBlock Grid.Column="2" Text="类型" Style="{StaticResource FieldLabelStyle}" Margin="10,0,6,0" />
                            <ComboBox x:Name="RuleKindBox" Grid.Column="3" Height="28" />

                            <TextBlock Grid.Column="4" Text="扩展名" Style="{StaticResource FieldLabelStyle}" Margin="10,0,6,0" />
                            <TextBox x:Name="RuleExtensionsBox" Grid.Column="5" Height="28" VerticalContentAlignment="Center" Padding="6,0" ToolTip="多个扩展名用逗号分隔，例如 png,jpg,gif" />

                            <TextBlock Grid.Column="6" Text="归入" Style="{StaticResource FieldLabelStyle}" Margin="10,0,6,0" />
                            <ComboBox x:Name="RuleTargetBox" Grid.Column="7" Height="28" />

                            <Button Grid.Column="8" Content="保存规则" Width="82" Height="28" Margin="10,0,0,0" Click="AddRuleButton_OnClick" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="名称关键词" Margin="0,8,6,0" VerticalAlignment="Center" />
                            <TextBox x:Name="RuleKeywordsBox" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="6" Height="28" Margin="0,8,0,0" Padding="6,0" VerticalContentAlignment="Center" ToolTip="多个关键词用逗号分隔，命中任意一个" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="新建" Width="64" Height="28" Click="NewRuleButton_OnClick" />
                        <Button Content="上移" Width="64" Height="28" Margin="8,0,0,0" Click="MoveRuleUpButton_OnClick" />
                        <Button Content="下移" Width="64" Height="28" Margin="8,0,0,0" Click="MoveRuleDownButton_OnClick" />
                        <Button Content="预览归类" Width="88" Height="28" Margin="8,0,0,0" Click="PreviewRulesButton_OnClick" />
                        <Button Content="删除选中规则" Width="120" Height="28" Click="DeleteRuleButton_OnClick" />
                    </StackPanel>
                    <TextBox x:Name="RulePreviewText" Grid.Row="3" Height="100" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Grid>
            </TabItem>

            <!-- 已排除条目 -->
            <TabItem Header="已排除条目">
                <Grid Margin="14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="右键条目选择「移出盒子」后，条目会被记录在这里，自动归类不会再把它收回任何盒子。文件被删除后记录自动清除。"
                               Style="{StaticResource HintStyle}"
                               Margin="0,0,0,8" />

                    <ListBox x:Name="ExcludedList" Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="2">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="13" />
                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="#77767B" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="恢复选中" Width="100" Height="28" Click="RestoreExcludedButton_OnClick" />
                        <Button Content="全部恢复" Width="100" Height="28" Margin="8,0,0,0" Click="RestoreAllExcludedButton_OnClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 关于 -->
            <TabItem Header="番茄钟">
                <StackPanel Margin="20">
                    <TextBlock Text="专注一件事，按时休息" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <TextBlock Text="默认专注 25 分钟、短休息 5 分钟，每完成 4 个番茄后长休息 15 分钟。" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="支持暂停继续、自定义时长、自动循环、声音与通知、每日目标和历史导出。在待办任务的右键菜单中，可直接选择“用番茄钟专注此任务”。" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="关闭番茄钟面板后计时继续；锁屏、休眠或退出软件时暂停并保存进度。" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <Button Content="打开番茄钟" HorizontalAlignment="Left" Padding="20,10" Click="OpenPomodoro_OnClick"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="关于">
                <StackPanel Margin="14,14">
                    <TextBlock Text="DeskFlow" FontSize="20" FontWeight="SemiBold" Foreground="#2C2C2A" />
                    <TextBlock x:Name="VersionText" Text="版本 1.0.0" FontSize="12" Foreground="#77767B" Margin="0,4,0,16" />

                    <TextBlock Text="轻量纯净的 Windows 桌面整理工具。核心功能完全离线可用，不上传任何文件名、路径与文件内容。" FontSize="13" Foreground="#2C2C2A" TextWrapping="Wrap" />

                    <TextBlock Text="配置文件" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="ConfigPathText" Text="" FontSize="12" Foreground="#444441" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="打开配置目录" Width="120" Height="28" Click="OpenConfigFolder_OnClick" />
                        <Button Content="重置为默认设置" Width="130" Height="28" Margin="8,0,0,0" Click="ResetConfig_OnClick" />
                                <Button Content="从备份恢复…" Width="115" Height="28" Margin="8,0,0,0" Click="RestoreBackupButton_OnClick" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Width="90" Height="32" Click="SaveButton_OnClick" />
            <Button Content="取消" Width="90" Height="32" Margin="10,0,0,0" Click="CancelButton_OnClick" />
        </StackPanel>
    </Grid>
</Window>
