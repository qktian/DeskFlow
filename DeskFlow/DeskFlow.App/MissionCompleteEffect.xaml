<Window x:Class="DeskFlow.App.MissionCompleteEffect"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" Height="172"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        IsHitTestVisible="False" SnapsToDevicePixels="True">
    <Window.Resources>
        <Storyboard x:Key="CelebrateStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="EffectRoot" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.35" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.85" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.74" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.23" Value="1.06" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.74" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.23" Value="1.06" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity"
                             From="0.8" To="0" Duration="0:0:0.35" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BadgeRotate" Storyboard.TargetProperty="Angle">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="-100" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="SweepMove" Storyboard.TargetProperty="X"
                             From="-460" To="460" BeginTime="0:0:0.25" Duration="0:0:0.65" />
            <DoubleAnimation Storyboard.TargetName="SparkLayer" Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.25" Duration="0:0:0.15" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="AccentScale" Storyboard.TargetProperty="ScaleX"
                             From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.45" />
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="EffectRoot" Opacity="0" Margin="5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="0.74" ScaleY="0.74" CenterX="230" CenterY="86" />
        </Grid.RenderTransform>

        <Border Margin="4,8" CornerRadius="14" Background="#EC0B1724"
                BorderBrush="#FF3CEBBE" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#FF37E9C5" BlurRadius="22" ShadowDepth="0" Opacity="0.68" />
            </Border.Effect>
            <Grid ClipToBounds="True">
                <Rectangle x:Name="Flash" Fill="#FF8BFFE5" Opacity="0" />
                <Rectangle Width="90" HorizontalAlignment="Left" Opacity="0.5">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#003CEBBE" Offset="0" />
                            <GradientStop Color="#AA3CEBBE" Offset="0.5" />
                            <GradientStop Color="#003CEBBE" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform><TranslateTransform x:Name="SweepMove" X="-460" /></Rectangle.RenderTransform>
                </Rectangle>

                <Grid Margin="27,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="58" Height="58" VerticalAlignment="Center">
                        <Ellipse Stroke="#FF3CEBBE" StrokeThickness="2" Fill="#222CE0B8" />
                        <TextBlock Text="✓" FontFamily="Segoe UI" FontSize="37" FontWeight="Bold"
                                   Foreground="#FFB2FFF0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,-4,0,0" />
                        <Grid.RenderTransform><RotateTransform x:Name="BadgeRotate" Angle="-100" CenterX="29" CenterY="29" /></Grid.RenderTransform>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="OBJECTIVE CLEARED" Foreground="#FF44EAC5"
                                   FontFamily="Bahnschrift" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="MISSION COMPLETED" Foreground="White"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="28" FontWeight="Bold"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                        <Rectangle Height="3" Fill="#FF3CEBBE" Margin="0,10,0,0" HorizontalAlignment="Left" Width="285"
                                   RenderTransformOrigin="0,0.5">
                            <Rectangle.RenderTransform><ScaleTransform x:Name="AccentScale" ScaleX="0" /></Rectangle.RenderTransform>
                        </Rectangle>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Canvas x:Name="SparkLayer" Opacity="0" IsHitTestVisible="False">
            <Ellipse Canvas.Left="5" Canvas.Top="10" Width="8" Height="8" Fill="#FF90FFE4" />
            <Ellipse Canvas.Left="420" Canvas.Top="3" Width="5" Height="5" Fill="#FFFFD66A" />
            <Ellipse Canvas.Left="445" Canvas.Top="90" Width="8" Height="8" Fill="#FF90FFE4" />
            <Ellipse Canvas.Left="42" Canvas.Top="157" Width="5" Height="5" Fill="#FFFFD66A" />
            <Ellipse Canvas.Left="390" Canvas.Top="155" Width="6" Height="6" Fill="#FF90FFE4" />
        </Canvas>
    </Grid>
</Window>
