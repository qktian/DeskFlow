<Window x:Class="DeskFlow.App.TodoBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="待办"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MinWidth="200">
    <Window.Resources>
        <Style x:Key="TodoTitleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="TodoDoneColor" Color="#4CAF50" />
        <SolidColorBrush x:Key="TodoOverdueColor" Color="#FF6B6B" />
    </Window.Resources>

    <Border x:Name="Frame"
            CornerRadius="12"
            BorderThickness="1"
            BorderBrush="#26FFFFFF"
            Background="#D9181E25"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleRow" Height="32" />
                <RowDefinition x:Name="ContentRow" Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border x:Name="TitleBar"
                    Grid.Row="0"
                    Background="#1AFFFFFF"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
                    MouseMove="TitleBar_OnMouseMove"
                    MouseLeftButtonUp="TitleBar_OnMouseLeftButtonUp"
                    MouseRightButtonUp="TitleBar_OnMouseRightButtonUp">
                <Grid>
                    <TextBlock x:Name="TitleText"
                               Text="待办事项"
                               Margin="12,0,70,0"
                               VerticalAlignment="Center"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,0" VerticalAlignment="Center">
                        <Button x:Name="AddButton" Content="＋" Style="{StaticResource TodoTitleButtonStyle}" ToolTip="新建任务"
                                Click="AddButton_OnClick" />
                        <Button x:Name="CollapseButton" Content="—" Style="{StaticResource TodoTitleButtonStyle}" ToolTip="折叠 / 展开"
                                Click="CollapseButton_OnClick" />
                        <Button x:Name="MoreButton" Content="···" Style="{StaticResource TodoTitleButtonStyle}" ToolTip="更多"
                                Click="MoreButton_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 任务列表 -->
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="TodoScroll"
                              Margin="6,4"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <ItemsControl x:Name="TodoHost">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="8"
                                        Padding="8,7"
                                        Margin="0,1,0,3"
                                        Background="#0FFFFFFF"
                                        BorderBrush="#14FFFFFF"
                                        BorderThickness="1"
                                        Tag="{Binding}"
                                        PreviewMouseLeftButtonUp="Todo_OnPreviewLeftButtonUp"
                                        MouseRightButtonUp="Todo_OnRightClick">
                                    <Grid Margin="{Binding IndentMargin}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 子任务折叠 / 展开（仅当有子任务时显示） -->
                                        <TextBlock Grid.Column="0"
                                                   Tag="ExpanderMarker"
                                                   Text="{Binding ExpanderGlyph}"
                                                   Foreground="#AAFFFFFF"
                                                   FontSize="11"
                                                   Width="14"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Cursor="Hand"
                                                   Visibility="{Binding ExpanderVisibility}"
                                                   MouseLeftButtonUp="Expander_OnMouseLeftButtonUp" />

                                        <!-- 完成圈 -->
                                        <Border Grid.Column="1"
                                                Width="17" Height="17"
                                                CornerRadius="9"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding CircleBrush}"
                                                BorderBrush="{Binding CircleBorder}"
                                                BorderThickness="1.5"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="Circle_OnMouseLeftButtonUp">
                                            <TextBlock Text="{Binding CircleCheck}"
                                                       Foreground="White"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{Binding TitleBrush}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextDecorations="{Binding TitleDecoration}" />
                                            <TextBlock Text="{Binding MetaText}"
                                                       Foreground="{Binding MetaBrush}"
                                                       FontSize="11"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- 优先级色点 -->
                                        <Border Grid.Column="3"
                                                Width="9" Height="9"
                                                CornerRadius="4.5"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding PriorityBrush}"
                                                ToolTip="{Binding PriorityTooltip}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyHint"
                           Text="点击 ＋ 添加第一条待办"
                           Foreground="#88FFFFFF"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False" />
            </Grid>

            <!-- 缩放手柄 -->
            <Thumb x:Name="ThumbTop" Grid.Row="0" Grid.RowSpan="2" Height="5" VerticalAlignment="Top"
                   HorizontalAlignment="Stretch" Cursor="SizeNS" Opacity="0"
                   DragDelta="ThumbTop_OnDragDelta" DragCompleted="Thumb_OnDragCompleted" DragStarted="Thumb_OnDragStarted" />
            <Thumb x:Name="ThumbBottom" Grid.Row="0" Grid.RowSpan="2" Height="5" VerticalAlignment="Bottom"
                   HorizontalAlignment="Stretch" Cursor="SizeNS" Opacity="0"
                   DragDelta="ThumbBottom_OnDragDelta" DragCompleted="Thumb_OnDragCompleted" DragStarted="Thumb_OnDragStarted" />
            <Thumb x:Name="ThumbLeft" Grid.Row="0" Grid.RowSpan="2" Width="5" HorizontalAlignment="Left"
                   VerticalAlignment="Stretch" Cursor="SizeWE" Opacity="0"
                   DragDelta="ThumbLeft_OnDragDelta" DragCompleted="Thumb_OnDragCompleted" DragStarted="Thumb_OnDragStarted" />
            <Thumb x:Name="ThumbRight" Grid.Row="0" Grid.RowSpan="2" Width="5" HorizontalAlignment="Right"
                   VerticalAlignment="Stretch" Cursor="SizeWE" Opacity="0"
                   DragDelta="ThumbRight_OnDragDelta" DragCompleted="Thumb_OnDragCompleted" DragStarted="Thumb_OnDragStarted" />
            <Thumb x:Name="ThumbBottomRight" Grid.Row="0" Grid.RowSpan="2" Width="16" Height="16"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0"
                   DragDelta="ThumbBottomRight_OnDragDelta" DragCompleted="Thumb_OnDragCompleted" DragStarted="Thumb_OnDragStarted" />
        </Grid>
    </Border>
</Window>
