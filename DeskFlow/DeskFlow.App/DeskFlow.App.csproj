<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DeskFlow.App</RootNamespace>
    <AssemblyName>DeskFlow</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DeskFlow.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskFlow.Core\DeskFlow.Core.csproj" />
    <ProjectReference Include="..\DeskFlow.Shell\DeskFlow.Shell.csproj" />
  </ItemGroup>

  <!-- 同时启用 WPF 与 WinForms 时两者命名空间会互相冲突（Application / Color / MouseEventArgs 等），
       这里移除 WinForms 的隐式 using，需要用到的文件自行显式引用。 -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
