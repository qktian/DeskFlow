<Window x:Class="DeskFlow.App.TodoCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本月打卡"
        Width="330"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#20242E"
        Topmost="True">
    <StackPanel Margin="14,12,14,14">
        <!-- 标题：任务名 -->
        <TextBlock x:Name="TaskTitle"
                   Text="任务"
                   Foreground="White"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />

        <!-- 月份切换 -->
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PrevButton" Grid.Column="0" Content="‹" Width="28" Height="26" FontSize="16"
                    Foreground="White" Background="#33FFFFFF" BorderThickness="0"
                    Click="PrevMonth_OnClick" />
            <TextBlock x:Name="MonthTitle" Grid.Column="1"
                       Text="2026 年 9 月"
                       Foreground="White" FontSize="13"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Button x:Name="NextButton" Grid.Column="2" Content="›" Width="28" Height="26" FontSize="16"
                    Foreground="White" Background="#33FFFFFF" BorderThickness="0"
                    Click="NextMonth_OnClick" />
        </Grid>

        <!-- 星期表头（周一开头） -->
        <Grid Margin="0,10,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="一" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="二" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="三" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="四" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="五" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="六" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="6" Text="日" Foreground="#88FFFFFF" FontSize="11" HorizontalAlignment="Center" />
        </Grid>

        <!-- 日期网格：代码填充 -->
        <Grid x:Name="CalendarBody">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        </Grid>

        <!-- 图例 -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                <Ellipse Width="8" Height="8" Fill="#4CAF50" VerticalAlignment="Center" />
                <TextBlock Text=" 已打卡" Foreground="#B0FFFFFF" FontSize="11" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                <Ellipse Width="8" Height="8" Fill="#FF6B6B" VerticalAlignment="Center" />
                <TextBlock Text=" 未打卡" Foreground="#B0FFFFFF" FontSize="11" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="#88FFFFFF" VerticalAlignment="Center" />
                <TextBlock Text=" 计划" Foreground="#B0FFFFFF" FontSize="11" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="点击过去或今天的小格可打卡 / 取消打卡（未来日期不可点）。"
                   Foreground="#77FFFFFF" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
