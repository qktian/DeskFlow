<Window x:Class="DeskFlow.App.TodoTaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建任务"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        Topmost="True">
    <StackPanel Margin="20,16">
        <TextBlock Text="任务标题" FontSize="12" Foreground="#5F5E5A" />
        <TextBox x:Name="TitleBox" Height="32" Margin="0,4,0,0" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"
                 TextChanged="TitleBox_OnTextChanged" />

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="类型" FontSize="12" Foreground="#5F5E5A" />
                <ComboBox x:Name="KindBox" Height="30" Margin="0,4,0,0" FontSize="13"
                          SelectionChanged="KindBox_OnSelectionChanged" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="紧急重要程度" FontSize="12" Foreground="#5F5E5A" />
                <ComboBox x:Name="PriorityBox" Height="30" Margin="0,4,0,0" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- 普通待办：截止时间 -->
        <StackPanel x:Name="DuePanel" Margin="0,12,0,0">
            <TextBlock Text="截止时间（可留空表示不设截止）" FontSize="12" Foreground="#5F5E5A" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <DatePicker x:Name="DueDateBox" Grid.Column="0" Height="30" FontSize="13" VerticalContentAlignment="Center" />
                <TextBox x:Name="DueTimeBox" Grid.Column="2" Height="30" FontSize="13"
                         VerticalContentAlignment="Center" Padding="6,0" ToolTip="格式 HH:mm，例如 18:00" />
            </Grid>
        </StackPanel>

        <!-- 循环待办：周期 + 起始日 -->
        <StackPanel x:Name="CyclePanel" Margin="0,12,0,0">
            <TextBlock Text="循环周期（每日 / 每周 / 每两周 / 每月）" FontSize="12" Foreground="#5F5E5A" />
            <ComboBox x:Name="PeriodBox" Height="30" Margin="0,4,0,0" FontSize="13" />
            <TextBlock Text="起始日期（从这天开始按周期重复）" FontSize="12" Foreground="#5F5E5A" Margin="0,8,0,0" />
            <DatePicker x:Name="StartDateBox" Height="30" Margin="0,4,0,0" FontSize="13" VerticalContentAlignment="Center" />
            <TextBlock Text="提示：双击任务可在独立窗口查看并点选「本月打卡日历」。" FontSize="11" Foreground="#8A93A6" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Margin="0,12,0,0">
            <TextBlock Text="状态" FontSize="12" Foreground="#5F5E5A" />
            <CheckBox x:Name="DoneBox" Content="已完成" Margin="0,4,0,0" FontSize="13" />
        </StackPanel>

        <Grid Margin="0,18,0,0" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="取消" Width="76" Height="32" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="SaveButton" Grid.Column="1" Content="保存" Width="76" Height="32" IsDefault="True" Click="SaveButton_OnClick" />
        </Grid>
    </StackPanel>
</Window>
