<Window x:Class="DeskFlow.App.TodoAppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="外观"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F6F8"
        Topmost="True">
    <StackPanel Margin="20,16">
        <TextBlock Text="背景颜色（ARGB/HEX，例如 #33000000 表示黑色 20% 透明）" FontSize="12" Foreground="#5F5E5A" />
        <TextBox x:Name="BgColorBox" Height="30" Margin="0,4,0,0" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" />

        <TextBlock Text="文字颜色（HEX，例如 #FFFFFF）" FontSize="12" Foreground="#5F5E5A" Margin="0,12,0,0" />
        <TextBox x:Name="TextColorBox" Height="30" Margin="0,4,0,0" FontSize="13" VerticalContentAlignment="Center" Padding="8,0" />

        <TextBlock Text="整体不透明度" FontSize="12" Foreground="#5F5E5A" Margin="0,12,0,0" />
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" VerticalAlignment="Center"
                    ValueChanged="Slider_OnValueChanged" />
            <TextBlock x:Name="OpacityValue" Grid.Column="1" Width="44" Text="100%"
                       Foreground="#333" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" />
        </Grid>

        <TextBlock Text="圆角" FontSize="12" Foreground="#5F5E5A" Margin="0,12,0,0" />
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="RadiusSlider" Minimum="0" Maximum="24" VerticalAlignment="Center"
                    ValueChanged="Slider_OnValueChanged" />
            <TextBlock x:Name="RadiusValue" Grid.Column="1" Width="44" Text="12"
                       Foreground="#333" FontSize="12" VerticalAlignment="Center" TextAlignment="Right" />
        </Grid>

        <Grid Margin="0,20,0,0" HorizontalAlignment="Right">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="取消" Width="76" Height="32" Margin="0,0,8,0" IsCancel="True" />
            <Button Grid.Column="1" Content="保存" Width="76" Height="32" IsDefault="True" Click="SaveButton_OnClick" />
        </Grid>
    </StackPanel>
</Window>
